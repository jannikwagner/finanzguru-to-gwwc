# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored. Treat the values inside it like a password.

# --- EffectiveAltruism.org / GWWC My Giving credentials ---
GWWC_EMAIL=your@email.com
GWWC_PASSWORD=replace-me

# --- Optional file location overrides ---
# Default: $HOME/.gwwc_import_state.json
# GWWC_STATE_FILE=~/.gwwc_import_state.json

# Default: $HOME/.gwwc_import_session.json
# GWWC_SESSION_FILE=~/.gwwc_import_session.json

# Set to "false" to show the browser window during automation (useful for debugging).
# GWWC_HEADLESS=true

# --- Finanzguru parser configuration ---
# Comma-separated list of `Hauptkategorie` values that count as donations.
FINANZGURU_DONATION_CATEGORIES=Spenden

# Currency assumed for Finanzguru transactions (ISO 4217).
FINANZGURU_CURRENCY=EUR
